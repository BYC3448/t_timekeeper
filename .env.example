# ─────────────────────────────────────────────────────────────
# 서버 전용 비밀 키 (Vercel 프로젝트 설정 > Environment Variables 에만 입력)
# ⚠️ 절대 VITE_ 접두사를 붙이지 마세요 — 붙이면 브라우저 번들에 그대로 노출됩니다.
# api/gemini.ts, api/upstage.ts 서버리스 함수에서만 process.env로 읽습니다.
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
UPSTAGE_API_KEY=

# ─────────────────────────────────────────────────────────────
# Firebase Web App 설정 (Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱)
# 이 값들은 브라우저에 노출되어도 안전한 "공개 식별자"입니다
# (실제 접근 제어는 Firestore 보안 규칙에서 합니다). 선택 사항 —
# 비워두면 localStorage 로컬 모드로 정상 작동합니다.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
